# Copier en .env :  cp .env.example .env  puis  nano .env

# Discord Developer Portal > ton application > Bot > Reset Token
DISCORD_TOKEN=

# Clic droit sur ton serveur > Copier l'identifiant du serveur (mode développeur activé)
GUILD_ID=

# Tes identifiants Discord (et celui de Clem), séparés par une virgule : reçoivent le rôle Fondateur
OWNER_IDS=

# Adresse du site (liens et images des messages)
SITE_URL=https://jdev-hub.fr

# 1 = supprime les salons par défaut d'un serveur neuf (#général, Général vocal)
CLEAN_DEFAULTS=1
