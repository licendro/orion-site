# ===== API de licences Orion =====
PORT=3020
HOST=127.0.0.1
# Base SQLite (créée toute seule)
DB_PATH=./data/licences.db
# Adresse publique (liens du changelog renvoyés aux serveurs FiveM)
PUBLIC_SITE_URL=https://jdev-hub.fr

# Clé privée Ed25519 qui signe les réponses : générée par « npm run keygen ». NE JAMAIS LA PARTAGER.
SIGNING_KEY=

# Jeton partagé avec le site (Admin, espace client). Long et aléatoire : openssl rand -hex 32
ADMIN_TOKEN=

# Même secret que le webhook Tebex du site (le site transfère les webhooks à l'API)
TEBEX_WEBHOOK_SECRET=

# Alertes (clé utilisée depuis plus de 2 IP) : webhook du salon #alertes Discord
DISCORD_ALERT_WEBHOOK=

# Sauvegardes : dossier + base du site à sauvegarder aussi (facultatif)
BACKUP_DIR=./backups
SITE_DB_PATH=/root/orion/data/orion.db
