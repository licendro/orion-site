# Copier ce fichier en .env sur le VPS :  cp .env.example .env  puis nano .env

# ---------- Site ----------
SITE_URL=https://jdev-hub.fr
PORT=3000
# Comptes Discord ayant accès à /admin (ton ID, celui de Clem), séparés par des virgules
ADMIN_DISCORD_IDS=
DISCORD_INVITE=https://discord.gg/
TOP_BANNER=

# ---------- Tebex ----------
# Clé publique du webstore (Headless API) : catalogue + paiement. Vide = mode démo.
TEBEX_PUBLIC_TOKEN=
# Clé secrète (Plugin API) : création des codes promo depuis l'admin
TEBEX_SECRET_KEY=
# Secret du webhook (Developers > Webhooks) : commandes, remboursements
TEBEX_WEBHOOK_SECRET=

# ---------- Discord ----------
# Portail développeur > OAuth2 : connexion des clients sur le site
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Token du bot + ID du serveur : ajoute automatiquement les clients au serveur à la connexion
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# (Facultatif, plus utilisé : les devis ouvrent maintenant un ticket via le bot)
DISCORD_QUOTE_WEBHOOK=

# ---------- Mentions légales (facultatif) ----------
LEGAL_NAME=
LEGAL_EMAIL=

# --- Optionnel ---
# Alertes staff (sinon le webhook créé par « npm run setup » dans #alertes est utilisé)
DISCORD_ALERT_WEBHOOK=

# --- Infos légales (plus simple : Admin → Infos légales) ---
# LEGAL_NAME= LEGAL_STATUS= LEGAL_SIRET= LEGAL_ADDRESS= LEGAL_EMAIL= LEGAL_PHONE= LEGAL_DIRECTOR=
# LEGAL_VAT="TVA non applicable, art. 293 B du CGI"
# HOST_NAME= HOST_ADDRESS= HOST_PHONE= MEDIATOR_NAME= MEDIATOR_URL= MEDIATOR_ADDRESS=

# --- API de licences (dossier licence-api/) ---
LICENCE_API_URL=http://127.0.0.1:3020
# Même valeur que ADMIN_TOKEN dans licence-api/.env
LICENCE_ADMIN_TOKEN=
