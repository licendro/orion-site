# Copier ce fichier en .env sur le VPS :  cp .env.example .env  puis nano .env

# Adresse publique du site (sans / à la fin)
SITE_URL=https://jdev-hub.fr

# Port local (Nginx renvoie vers ce port)
PORT=3000

# Tebex > Integrations > Headless API > "Public token"
# Laisser vide = catalogue de démonstration, paiement désactivé.
TEBEX_PUBLIC_TOKEN=

# Webhook Discord où arrivent les demandes de devis
# (Discord > Paramètres du salon > Intégrations > Webhooks > Copier l'URL)
DISCORD_QUOTE_WEBHOOK=

# Lien d'invitation de ton serveur Discord (affiché sur le site)
DISCORD_INVITE=https://discord.gg/

# Bandeau en haut du site (laisser vide pour ne rien afficher)
TOP_BANNER=
